{
  "info": {
    "_postman_id": "parknova-enforcer-gate",
    "name": "ParkNova Enforcer Gate",
    "description": "Workforce Enforcer APIs via gateway.\n\nAuth: JWT from Keycloak realm **eden-crm-sec-users** in `enforcer_access_token`,\nor local headers `X-Officer-Sub` when calling mobile `:8081` directly.\n\nFlow: Catalog → Assign → Check (IN) → (Enter if needed) → Active timer on consumer → Check (OUT) → Mark paid → Exit.\n\nDemo plates: AAA111–AAA118. See docs/ENFORCER-API.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "enforcer_access_token", "value": "" },
    { "key": "officerSub", "value": "enforcer-officer-1" },
    { "key": "garageId", "value": "1" },
    { "key": "zoneId", "value": "10" },
    { "key": "gateId", "value": "ENTRY-1" },
    { "key": "plateNumber", "value": "AAA112" },
    { "key": "invoiceId", "value": "1" },
    { "key": "sessionId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "1.1 Catalog",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/catalog"
          }
        },
        {
          "name": "1.2 Registration types",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/registration-types"
          }
        },
        {
          "name": "1.3 Assign garage/zone/gate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/assignments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"garageId\": {{garageId}},\n  \"zoneId\": {{zoneId}},\n  \"gateId\": \"{{gateId}}\"\n}"
            }
          }
        },
        {
          "name": "1.4 Current assignment",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/assignments/current"
          }
        },
        {
          "name": "1.5 Capacity",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/capacity?garageId={{garageId}}&zoneId={{zoneId}}"
          }
        }
      ]
    },
    {
      "name": "2. Entry",
      "item": [
        {
          "name": "2.1 Check IN",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/gates/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"IN\",\n  \"plateNumber\": \"{{plateNumber}}\",\n  \"plateCountry\": \"SA\",\n  \"registrationType\": \"PRIVATE\",\n  \"garageId\": {{garageId}},\n  \"zoneId\": {{zoneId}},\n  \"gateId\": \"{{gateId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.sessionId) pm.collectionVariables.set('sessionId', String(j.sessionId));",
                  "  if (j.session && j.session.id) pm.collectionVariables.set('sessionId', String(j.session.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Enter (confirm / as consumer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/gates/enter",
            "description": "Only when outcome requires confirm (e.g. CONFIRM_ENTER_CONSUMER or SHARED_FULL fallback). Skip for AUTO_ENTER_*.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateNumber\": \"{{plateNumber}}\",\n  \"plateCountry\": \"SA\",\n  \"registrationType\": \"PRIVATE\",\n  \"garageId\": {{garageId}},\n  \"zoneId\": {{zoneId}},\n  \"gateId\": \"{{gateId}}\",\n  \"admissionPool\": \"CONSUMER\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Exit",
      "item": [
        {
          "name": "3.1 Check OUT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/gates/check",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"OUT\",\n  \"plateNumber\": \"{{plateNumber}}\",\n  \"plateCountry\": \"SA\",\n  \"registrationType\": \"PRIVATE\",\n  \"garageId\": {{garageId}},\n  \"zoneId\": {{zoneId}},\n  \"gateId\": \"EXIT-1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.invoice && j.invoice.id) pm.collectionVariables.set('invoiceId', String(j.invoice.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Mark invoice paid (stub)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/invoices/{{invoiceId}}/mark-paid"
          }
        },
        {
          "name": "3.3 Exit confirm",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/gates/exit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateNumber\": \"{{plateNumber}}\",\n  \"plateCountry\": \"SA\",\n  \"registrationType\": \"PRIVATE\",\n  \"garageId\": {{garageId}},\n  \"zoneId\": {{zoneId}},\n  \"gateId\": \"EXIT-1\",\n  \"invoiceId\": {{invoiceId}}\n}"
            }
          }
        },
        {
          "name": "3.4 Activity log",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{enforcer_access_token}}" },
              { "key": "X-Officer-Sub", "value": "{{officerSub}}" }
            ],
            "url": "{{baseUrl}}/enforcer/v1/activity?page=0&size=20"
          }
        }
      ]
    }
  ]
}
