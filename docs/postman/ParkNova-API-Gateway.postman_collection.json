    {
      "name": "6. Parking happy path",
      "description": "Consumer: prepare \u2192 poll active \u2192 pay. Gate entry/exit is Enforcer+Kafka in production. 6.2/6.4 ANPR = compat/test simulator only. Use either 6.4 or 6.5 to end.",
      "item": [
        {
          "name": "6.1 Prepare Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/client/v1/sessions/prepare",
            "description": "Select product before arrival.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"garageId\": {{garageId}},\n  \"productId\": {{productId}},\n  \"vehicleId\": {{vehicleId}}\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.collectionVariables.set('sessionId', String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6.2 ANPR Check-In (gate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-SERVICE-TO-SERVICE",
                "value": "{{serviceSecret}}"
              }
            ],
            "url": "{{baseUrl}}/internal/v1/sessions/check-in",
            "description": "COMPAT/TEST only. Production: Enforcer gates/check+enter via Kafka. Not called by consumer Flutter. Requires serviceSecret.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateNumber\": \"{{plateNumber}}\",\n  \"plateCountry\": \"{{plateCountry}}\",\n  \"garageId\": {{garageId}},\n  \"gateId\": \"ENTRY-1\",\n  \"recognizedAt\": \"2026-07-27T10:00:00Z\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.id) pm.collectionVariables.set('sessionId', String(j.id));",
                  "  if (j.sessionId) pm.collectionVariables.set('sessionId', String(j.sessionId));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6.3 Active Session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/client/v1/sessions/active",
            "description": "Live session / timer."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().id) {",
                  "  pm.collectionVariables.set('sessionId', String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6.4 ANPR Check-Out (gate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-SERVICE-TO-SERVICE",
                "value": "{{serviceSecret}}"
              }
            ],
            "url": "{{baseUrl}}/internal/v1/sessions/check-out",
            "description": "COMPAT/TEST only. Production: Enforcer Out mode + payment-gated exit via Kafka. Prefer this OR 6.5 (not both).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateNumber\": \"{{plateNumber}}\",\n  \"plateCountry\": \"{{plateCountry}}\",\n  \"garageId\": {{garageId}},\n  \"gateId\": \"EXIT-1\",\n  \"recognizedAt\": \"2026-07-27T12:00:00Z\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ((pm.response.code === 200 || pm.response.code === 201) && pm.response.json().invoice) {",
                  "  pm.collectionVariables.set('invoiceId', String(pm.response.json().invoice.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6.5 End Session (app alternative)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/client/v1/sessions/{{sessionId}}/end",
            "description": "App-side end session (alternative to gate check-out)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().invoice) {",
                  "  pm.collectionVariables.set('invoiceId', String(pm.response.json().invoice.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6.6 Pay Invoice (STUB)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/client/v1/invoices/{{invoiceId}}/pay",
            "description": "Stub payment \u2014 always PAID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CARD\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.paymentId) pm.collectionVariables.set('paymentId', String(j.paymentId));",
                  "  if (j.id) pm.collectionVariables.set('paymentId', String(j.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6.7 Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/client/v1/payments/{{paymentId}}",
            "description": ""
          },
          "response": []
        }
      ]
    },
