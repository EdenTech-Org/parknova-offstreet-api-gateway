    {
      "name": "5. Garages",
      "description": "Discovery map APIs",
      "item": [
        {
          "name": "5.1 List Garages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/client/v1/garages?lat={{lat}}&lng={{lng}}&radiusKm=10&includePeriods=true&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "client",
                "v1",
                "garages"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lng",
                  "value": "{{lng}}"
                },
                {
                  "key": "radiusKm",
                  "value": "10"
                },
                {
                  "key": "includePeriods",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Nearby garages. Saves first garageId and optional productId."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  const list = j.content || j.items || j;",
                  "  if (Array.isArray(list) && list.length) {",
                  "    pm.collectionVariables.set('garageId', String(list[0].id || list[0].garageId));",
                  "    const products = list[0].products || list[0].pricing || [];",
                  "    if (products.length && products[0].id) {",
                  "      pm.collectionVariables.set('productId', String(products[0].id));",
                  "    }",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "5.2 Get Garage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{baseUrl}}/client/v1/garages/{{garageId}}",
            "description": "Garage detail + prices; set productId from response if needed."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
